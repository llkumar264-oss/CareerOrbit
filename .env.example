# Local defaults. The Python app loads .env from the repository root.
DATABASE_URL=sqlite:///./careerorbit.db
STORAGE_DIR=./storage
APP_URL=http://localhost:3000
API_URL=http://localhost:8000
NEXT_PUBLIC_API_URL=http://localhost:8000
PRODUCTION=false
# Generate with: .venv/bin/python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# Required for production; local development generates storage/.encryption-key.
ENCRYPTION_KEY=
# Compose: generate a long URL-safe password, never reuse another password.
POSTGRES_PASSWORD=
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
HUNTER_API_KEY=
SERPAPI_API_KEY=
# Optional: HTTPS OpenAI-compatible base URL, e.g. ending in /v1.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
